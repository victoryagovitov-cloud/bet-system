API_SPORT_BASE_URL=https://api.api-sport.ru
API_SPORT_KEY=
API_SPORT_SPORT_SLUG=football

BOOKMAKERS_WHITELIST=marathon,melbet,betboom,pari

MAX_BOT_TOKEN=
MAX_CHANNEL_CHAT_ID=
# dry_run|live — dry_run пишет сигналы в data/signals_dry_run/ без отправки в MAX
PUBLISH_MODE=dry_run

MIN_MODEL_PROBABILITY=0.80
# Минимальный запас модели над линией (2 п.п.). 0 = только edge>0
MIN_EDGE=0.02
MAX_EDGE=0.15
MAX_VALUE_SIGNALS_PER_RUN=5
STAKE_HARD_CAP_FRACTION=0.0333
KELLY_FRACTION_MODE=quarter

BANKROLL_AMOUNT=30000
TIMEZONE=Europe/Moscow

DATABASE_URL=sqlite:///data/signals.db

# Аномальный разброс коэффициентов между 4 БК (абсолютные пункты odds)
ODDS_SPREAD_ANOMALY_THRESHOLD=0.80

# Слой качественной проверки (выключен по умолчанию)
LLM_QUALITY_ENABLED=false

NEWS_LLM_ENABLED=false
NEWS_LLM_API_KEY=
NEWS_LLM_BASE_URL=https://api.perplexity.ai
NEWS_LLM_MODEL=sonar
# Резерв для новостей (если primary молчит/падает)
NEWS_LLM_FALLBACK_API_KEY=
NEWS_LLM_FALLBACK_BASE_URL=
NEWS_LLM_FALLBACK_MODEL=

# Логика текста перед постом — дешёвая модель (DeepSeek и т.п.)
# При желании можно поставить Claude: LOGIC_LLM_BASE_URL=https://api.anthropic.com/v1
# и LOGIC_LLM_MODEL=claude-sonnet-4-20250514 + ключ Anthropic
LOGIC_LLM_ENABLED=false
LOGIC_LLM_API_KEY=
LOGIC_LLM_BASE_URL=https://api.aitunnel.ru/v1
LOGIC_LLM_MODEL=deepseek-chat
# Резерв: другая модель/шлюз (тот же ключ AITunnel можно, другая модель)
LOGIC_LLM_FALLBACK_API_KEY=
LOGIC_LLM_FALLBACK_BASE_URL=
LOGIC_LLM_FALLBACK_MODEL=

# Верняки: префильтр + обязательный AI (fail-closed без ключа)
LOCK_SIGNALS_ENABLED=true
LOCK_MIN_MODEL_PROBABILITY=0.78
LOCK_ODDS_MIN=1.12
LOCK_ODDS_MAX=1.45
LOCK_MIN_LAMBDA_GAP=0.35
LOCK_MIN_H2H_GAMES=5
LOCK_MIN_H2H_SHARE=0.65
LOCK_AI_MIN_CONFIDENCE=0.75
LOCK_STAKE_FRACTION=0.01667
# По умолчанию = LOGIC_LLM_*; можно переопределить
LOCK_LLM_API_KEY=
LOCK_LLM_BASE_URL=
LOCK_LLM_MODEL=
# Резерв для верняка (по умолчанию = LOGIC_LLM_FALLBACK_*)
LOCK_LLM_FALLBACK_API_KEY=
LOCK_LLM_FALLBACK_BASE_URL=
LOCK_LLM_FALLBACK_MODEL=
